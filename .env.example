# models
ZSC_MODEL=NbAiLab/nb-bert-base-mnli
NER_MODEL=Kushtrim/norbert3-large-ner

# zero-shot settings
ZSC_MULTI_LABEL=true
ZSC_MAX_LEN=2048

# Hugging Face cache (improves cold start)
HF_HOME=/app/.hf
TRANSFORMERS_CACHE=/app/.hf/transformers

# server
PORT=8080

# CORS (comma-separated, pydantic parses into list)
CORS_ORIGINS=http://localhost:3000,https://my-ror-app.com
