# models
NDM_ZSC_MODEL=NbAiLab/nb-bert-base-mnli
NDM_NER_MODEL=NbAiLab/nb-bert-base-ner
NDM_ZSC_REVISION=171cd472d61d91ad6609530997e63ea98515efcb
NDM_NER_REVISION=98083f61535300a7fb6d8b72c26873d47e81ac93

# zero-shot settings
NDM_ZSC_MULTI_LABEL=true
NDM_ZSC_MAX_LEN=2048

# Hugging Face cache (improves cold start)
NDM_HF_HOME=/app/.hf

# server
NDM_HOST=0.0.0.0
NDM_PORT=8080

# CORS (JSON array; default [] denies all cross-origin access)
NDM_CORS_ORIGINS=["http://localhost:3000","https://my-ror-app.com"]
