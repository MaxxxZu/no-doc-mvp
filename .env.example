# models
NDM_ZSC_MODEL=NbAiLab/nb-bert-base-mnli
NDM_NER_MODEL=NbAiLab/nb-bert-base-ner
NDM_ZSC_REVISION=171cd472d61d91ad6609530997e63ea98515efcb
NDM_NER_REVISION=98083f61535300a7fb6d8b72c26873d47e81ac93

# zero-shot settings
NDM_ZSC_MULTI_LABEL=true
NDM_ZSC_MAX_LEN=2048
# Original text character limit for NER and request body limit in bytes
NDM_NER_MAX_LEN=2048
NDM_BODY_MAX_BYTES=65536

# Artifact cache directory passed directly to Hugging Face loaders (not a parent HF_HOME)
NDM_HF_HOME=/app/.hf
NDM_OFFLINE=false
# Process-wide PyTorch intra-op threads; all apps in a process must agree (1-256)
NDM_CPU_THREADS=2

# server
NDM_HOST=0.0.0.0
NDM_PORT=8080

# CORS (JSON array; default [] denies all cross-origin access)
NDM_CORS_ORIGINS=["http://localhost:3000","https://my-ror-app.com"]
